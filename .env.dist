# ============================================================
# HistoCar — Variables d'environnement
# ============================================================
# Copier ce fichier en .env et renseigner les valeurs :
#   cp .env.dist .env
#
# ⚠️  Ne jamais commiter le fichier .env (ignoré par git).
#     Ce fichier .env.dist est versionné : pas de vraies valeurs.
#
# ⚠️  docker compose lit ce .env avec `format: raw` : les `$`
#     du hash bcrypt ne sont PAS interpolés. Ne pas retirer.
# ============================================================

# ── Postgres ──────────────────────────────────────────────────
POSTGRES_USER=histocar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=histocar
# ⚠️  Changer POSTGRES_PASSWORD n'a aucun effet sur un volume
#     existant : Postgres ne l'applique qu'à l'initialisation.
DATABASE_URL=postgresql://histocar:change-me@db:5432/histocar

# ── Serveur ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# ⚠️  Sert de whitelist CORS (Access-Control-Allow-Origin) : mettre le vrai
#     hostname public en prod (https://histocar.example.com), pas
#     localhost. Dev : http://localhost:5173
WEB_ORIGIN=http://localhost:8080

# ── Authentification (comptes en base, table User) ────────────
JWT_SECRET=change-me-to-a-long-random-string

# Code exigé par le formulaire de création de compte. Laisser vide ferme
# les inscriptions (la route répond 403).
SIGNUP_INVITE_CODE=

# ── Amorçage du compte propriétaire ───────────────────────────
# Utilisés uniquement par le service `migrate`, pour rattacher les véhicules
# créés avant la table User. Sans effet une fois le rattachement fait :
# les mots de passe vivent ensuite en base. Peuvent être vidés ensuite.
AUTH_USERNAME=admin
# Écrire directement : make set-password PASSWORD=<mot-de-passe>
# ⚠️  Pas de guillemets autour de la valeur : avec `format: raw` docker
#     compose ne les retire pas, ils entrent dans le hash et le login échoue.
AUTH_PASSWORD_HASH=

# ── Cloudflare Tunnel (prod only, via le sous-module cloudflared-tunnel) ──
# UUID du tunnel créé via : cloudflared tunnel create histocar-tunnel
# Le fichier <UUID>.json doit être déposé dans ./cloudflared/
TUNNEL_UUID=
CLOUDFLARED_CONFIG_PATH=./cloudflared
TUNNEL_CONTAINER_NAME=cloudflared-tunnel-histocar
TUNNEL_IMAGE=cloudflare/cloudflared:2026.9.1
